{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:image-to-cad:perception-v2:source-evidence-record:1",
  "title": "Perception V2 source-evidence provenance record",
  "type": "object",
  "additionalProperties": false,
  "required": ["SOURCE_FAMILY_ID","DOCUMENT_ID","document_title","publisher_organization","drafting_vendor","discipline","era_date","landing_page_url","final_binary_url","access_timestamp","original_filename","mime_type","byte_size","sha256","page_sheet_count","vector_raster_mixed","generation_process","duplicate_mirror_relationships","style_independence_rationale","source_family_independence_axes","page_sheet_identifiers","render_transformation_history","candidates"],
  "properties": {
    "SOURCE_FAMILY_ID":{"type":"string","minLength":1},
    "DOCUMENT_ID":{"type":"string","minLength":1},
    "document_title":{"type":"string","minLength":1},
    "publisher_organization":{"type":"string","minLength":1},
    "drafting_vendor":{"type":["string","null"]},
    "discipline":{"type":"string","minLength":1},
    "era_date":{"type":["string","null"]},
    "landing_page_url":{"type":"string","format":"uri"},
    "final_binary_url":{"type":"string","format":"uri"},
    "access_timestamp":{"type":"string","format":"date-time"},
    "original_filename":{"type":"string","minLength":1},
    "mime_type":{"type":"string","minLength":1},
    "byte_size":{"type":"integer","minimum":1},
    "sha256":{"type":"string","pattern":"^[A-Fa-f0-9]{64}$"},
    "page_sheet_count":{"type":"integer","minimum":1},
    "vector_raster_mixed":{"enum":["VECTOR","RASTER","MIXED","UNKNOWN"]},
    "generation_process":{"type":"string","minLength":1},
    "duplicate_mirror_relationships":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["related_document_or_url","relationship"],"properties":{"related_document_or_url":{"type":"string"},"relationship":{"enum":["DUPLICATE_BYTES","MIRROR","DERIVED_RENDER","SAME_ORIGINAL","RELATED_TEMPLATE","NONE_KNOWN"]},"notes":{"type":"string"}}}},
    "style_independence_rationale":{"type":"string","minLength":1},
    "source_family_independence_axes":{"type":"array","minItems":2,"uniqueItems":true,"items":{"enum":["organization_publisher_vendor","discipline","drafting_convention","document_generation_process","vector_raster_scan_origin","scan_raster_degradation","typography_layout_system","dimensioning_convention","line_weight_convention","title_revision_layout_convention"]}},
    "page_sheet_identifiers":{"type":"array","minItems":1,"items":{"type":"string"}},
    "render_transformation_history":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["sequence","operation","parameters","tool_version","input_sha256","output_sha256"],"properties":{"sequence":{"type":"integer","minimum":1},"operation":{"type":"string"},"parameters":{"type":"object"},"tool_version":{"type":"string"},"input_sha256":{"type":"string","pattern":"^[A-Fa-f0-9]{64}$"},"output_sha256":{"type":"string","pattern":"^[A-Fa-f0-9]{64}$"}}}},
    "candidates":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["CANDIDATE_ID","page_sheet_identifier","crop_coordinates","INDEPENDENCE_CLUSTER_ID","proposal_mechanisms","review_artifacts"],"properties":{"CANDIDATE_ID":{"type":"string","minLength":1},"page_sheet_identifier":{"type":"string","minLength":1},"crop_coordinates":{"type":"object","additionalProperties":false,"required":["coordinate_space","x_min","y_min","x_max","y_max"],"properties":{"coordinate_space":{"type":"string"},"x_min":{"type":"number"},"y_min":{"type":"number"},"x_max":{"type":"number"},"y_max":{"type":"number"}}},"INDEPENDENCE_CLUSTER_ID":{"type":"string","minLength":1},"proposal_mechanisms":{"type":"array","minItems":1,"items":{"type":"string"}},"review_artifacts":{"type":"object","additionalProperties":false,"required":["local_source_crop","broader_context_crop","fragment_gap_overlay"],"properties":{"local_source_crop":{"type":"string"},"broader_context_crop":{"type":"string"},"fragment_gap_overlay":{"type":"string"},"source_support_binary_overlay":{"type":["string","null"]}}}}}}
  },
  "x_protocol": {"rights_approval_is_separate":true,"candidate_proposal_does_not_assign_label":true,"counts_require_independence_cluster_deduplication":true}
}
