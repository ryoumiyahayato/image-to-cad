{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source": {
      "type": "object",
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "region": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "units": {
          "enum": [
            "source_pixel",
            "mm",
            "unitless"
          ]
        }
      },
      "required": [
        "sha256",
        "page",
        "region",
        "authority",
        "units"
      ],
      "additionalProperties": false
    },
    "before_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "after_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "texts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "handle": {
            "type": "string",
            "pattern": "^[0-9A-F]+$"
          },
          "expected_text": {
            "type": "string",
            "minLength": 1
          },
          "cell": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "source_outline_handles": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9A-F]+$"
            },
            "uniqueItems": true,
            "maxItems": 1000
          },
          "outline_mapping_complete": {
            "type": "boolean"
          },
          "ownership_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "handle",
          "expected_text"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000
    },
    "protected": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "logo",
              "signature",
              "stamp",
              "non_editable_background"
            ]
          },
          "handles": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9A-F]+$"
            },
            "uniqueItems": true,
            "maxItems": 1000
          },
          "authority": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "role",
          "handles",
          "authority"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "table": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "layer": {
          "type": "string",
          "minLength": 1
        },
        "mapping_complete": {
          "type": "boolean"
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_segments": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "minItems": 1,
          "maxItems": 100
        }
      },
      "required": [
        "id",
        "layer",
        "mapping_complete",
        "source_ref",
        "source_segments"
      ],
      "additionalProperties": false
    },
    "edit": {
      "type": "object",
      "properties": {
        "allowed_handles": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9A-F]+$"
          },
          "uniqueItems": true,
          "maxItems": 1000
        },
        "allowed_new_handles": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9A-F]+$"
          },
          "uniqueItems": true,
          "maxItems": 1000
        }
      },
      "required": [
        "allowed_handles"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "source",
    "before_sha256",
    "after_sha256",
    "texts"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
