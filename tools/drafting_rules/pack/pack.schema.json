{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "parameters": {
      "type": "object",
      "properties": {
        "cell_tolerance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "line_endpoint_tolerance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "cell_tolerance",
        "line_endpoint_tolerance"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "type": "string",
            "minLength": 1
          },
          "verified_full_text": {
            "type": "boolean"
          },
          "edition": {
            "type": [
              "string",
              "null"
            ]
          },
          "clause": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "location",
          "locator",
          "verification"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "enum": [
              "OFFICIAL_STANDARD",
              "PRODUCT_REQUIREMENT",
              "EXPERIMENTAL_HEURISTIC"
            ]
          },
          "state": {
            "enum": [
              "IMPLEMENTED",
              "CANDIDATE"
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "contract": {
            "type": "string",
            "minLength": 1
          },
          "abstain": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "classification",
          "state",
          "sources",
          "contract",
          "abstain"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "id",
    "version",
    "license",
    "scope",
    "dependencies",
    "parameters",
    "sources",
    "rules"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
