{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ryoumiyahayato/image-to-cad/blob/draftsman/cloud-baseline-20260908/docs/draftsman/corpus/g0_candidate_registry.schema.json",
  "title": "Draftsman G0 candidate registry record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_group_id",
    "candidate_ids",
    "canonical_source_url",
    "landing_page_url",
    "retrieval_url",
    "organization",
    "project_or_package",
    "region",
    "country_or_area",
    "source_type",
    "file_format",
    "vector_raster_status",
    "historical_archival",
    "degraded_scan",
    "native_image",
    "era",
    "discipline",
    "drawing_type",
    "discovery_phase",
    "quality_tier",
    "quality_flags",
    "governance_status",
    "governance_or_access_notes",
    "source_family_id",
    "source_group_independence_notes",
    "recovery_provenance",
    "record_status",
    "split_eligibility",
    "identity_scope",
    "dedup_status",
    "legacy_proposal_role",
    "legacy_planned_split",
    "legacy_proposal_authoritative"
  ],
  "properties": {
    "schema_version": {"const": "draftsman-g0-candidate-registry-v1"},
    "source_group_id": {"type": "string", "minLength": 1},
    "candidate_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "canonical_source_url": {"type": "string", "pattern": "^https?://"},
    "landing_page_url": {"type": ["string", "null"]},
    "retrieval_url": {"type": ["string", "null"]},
    "organization": {"type": "string"},
    "project_or_package": {"type": "string"},
    "region": {"type": "string"},
    "country_or_area": {"type": "string"},
    "source_type": {"type": "string"},
    "file_format": {"type": "string"},
    "vector_raster_status": {"enum": ["CONFIRMED_VECTOR", "CONFIRMED_RASTER", "CONFIRMED_MIXED", "UNKNOWN"]},
    "historical_archival": {"type": ["boolean", "null"]},
    "degraded_scan": {"type": ["boolean", "null"]},
    "native_image": {"type": ["boolean", "null"]},
    "era": {"type": "string"},
    "discipline": {"type": "string"},
    "drawing_type": {"type": "string"},
    "discovery_phase": {"enum": ["G0-A", "G0-A2", "G0-R2", "RECOVERED_LEGACY", "FUTURE_REDISCOVERY"]},
    "quality_tier": {"enum": ["STRONG", "SECONDARY", "UNKNOWN"]},
    "quality_flags": {"type": "array", "items": {"type": "string"}},
    "governance_status": {"type": "string"},
    "governance_or_access_notes": {"type": "string"},
    "source_family_id": {"type": "string"},
    "source_group_independence_notes": {"type": "string", "minLength": 1},
    "recovery_provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": {"type": "string"},
          "artifact_name": {"type": "string"},
          "artifact_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "member_path": {"type": "string"},
          "candidate_id": {"type": "string"},
          "source_url": {"type": "string", "pattern": "^https?://"},
          "observed_at": {"type": "string", "format": "date"},
          "search_query": {"type": "string"},
          "evidence_note": {"type": "string"}
        },
        "additionalProperties": false,
        "oneOf": [
          {"required": ["artifact_name", "artifact_sha256", "member_path"]},
          {"required": ["source_url", "observed_at"]}
        ]
      }
    },
    "record_status": {"enum": ["RECOVERED_REAL_CANDIDATE", "REDISCOVERED_REAL_CANDIDATE"]},
    "split_eligibility": {"enum": ["PROVISIONAL_PENDING_ACQUISITION", "INELIGIBLE", "UNRESOLVED", "RESTRICTED", "REVIEW_REQUIRED"]},
    "identity_scope": {"enum": ["SOURCE_GROUP", "UNRESOLVED"]},
    "dedup_status": {"enum": ["DISTINCT", "UNRESOLVED"]},
    "legacy_proposal_role": {"enum": ["SELECTED", "RESERVE", null]},
    "legacy_planned_split": {"enum": ["DEV", "VALIDATION", "LOCKED_BLIND", null]},
    "legacy_proposal_authoritative": {"const": false}
  }
}
